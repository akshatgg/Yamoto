# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (just the content="" value).
NEXT_PUBLIC_GSC_VERIFICATION=

# Quote-form lead delivery by email (https://resend.com). Without these, leads go to WhatsApp only.
RESEND_API_KEY=
LEAD_TO_EMAIL=owner@example.com
# Must be on a domain verified in Resend, e.g. "Yamoto Website <leads@yamoto.com>".
LEAD_FROM_EMAIL=
